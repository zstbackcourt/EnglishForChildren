.chapter { margin-top:40rpx; }.chapter-heading { display:flex; align-items:center; gap:20rpx; }.chapter-number { font-size:56rpx; color:#ceac81; font-weight:750; }.chapter-heading .section-title { margin:0; }.lesson-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:20rpx; }.lesson-tile { text-align:left; background:#fffdf8; border:2rpx solid #ecdac0; padding:24rpx; margin:0; min-height:204rpx; }.lesson-number { color:#ac694b; font-size:21rpx; letter-spacing:2rpx; }.lesson-title { font-size:29rpx; font-weight:650; margin:10rpx 0; }.lesson-foot { font-size:22rpx; color:#8a7868; }
