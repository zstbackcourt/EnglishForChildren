<view class="screen"><view wx:if="{{loading}}" class="loading">故事正在翻开…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重新打开</button></view>
  <block wx:if="{{lesson &amp;&amp; !loading &amp;&amp; !error}}"><view class="row"><text class="eyebrow">LESSON {{lesson.id}}</text><button open-type="share" class="small">分享故事 ↗</button></view><view class="title">{{lesson.title}}</view><view class="subtitle">{{player ? player.name + '，一起听一听吧' : '先听故事，再创建角色记录成长'}} · 原版美音</view>
    <image wx:if="{{sceneUrl}}" class="story-image" src="{{sceneUrl}}" mode="widthFix" bindtap="preview" show-menu-by-longpress="{{true}}"/><view class="note">轻点插画可放大 · 本课配对录音第 {{lesson.audioLesson}} 课</view>
    <view class="audio-panel"><view class="row"><view class="section-title">耳朵准备好了吗？</view><text class="pill">{{cursor + 1}} / {{lesson.lines.length}}</text></view><view class="actions"><button class="primary" wx:if="{{!playing}}" bindtap="playAll">▶ 从这里连续听</button><button wx:else class="primary" bindtap="pause">Ⅱ 停一停</button><button bindtap="toggleTranslation">{{showTranslation ? '收起中文' : '看看中文'}}</button></view><view wx:if="{{audioError}}" class="error">{{audioError}}<button class="small" bindtap="retryAudio">重试音频</button></view></view>
    <scroll-view class="dialogue" scroll-y="{{true}}" scroll-into-view="{{scrollTo}}" scroll-with-animation="{{true}}"><view wx:for="{{lesson.lines}}" wx:key="index" class="line {{cursor === index ? 'active' : ''}}" id="line-{{index}}" data-index="{{index}}" bindtap="playLine"><view class="line-speaker">{{item.speaker || '跟我读'}} <text>▶ {{index + 1}}</text></view><view class="english">{{item.text}}</view><view class="translation" wx:if="{{showTranslation}}">{{item.translation}}</view></view></scroll-view>
    <view wx:if="{{progressError}}" class="error" bindtap="saveProgress">{{progressError}}</view><view class="note">点一句听一句；连续播放时，字幕会跟着声音走。</view>
    <view class="card"><view class="section-title">把故事变成小挑战</view><view class="difficulties"><button wx:for="{{difficulties}}" wx:key="*this" class="small {{difficulty === index ? 'selected' : ''}}" data-id="{{index}}" bindtap="difficulty">{{item}}</button></view><view class="muted">小小耳朵：听音选择 · 句子魔法：选择与排序 · 单词勇士：听音填词。每轮 5 题，首次过关收集星光。</view><button class="primary" bindtap="challenge">{{player ? '准备好了，去挑战 →' : '创建角色，开始挑战 →'}}</button></view>
    <view class="card"><view class="section-title">绘本原页</view><image wx:if="{{pageUrl}}" class="page-image" src="{{pageUrl}}" mode="widthFix" lazy-load="{{true}}" bindtap="preview"/></view>
  </block>
</view>
