.story-image,.page-image { width:100%; display:block; border-radius:28rpx; margin-top:24rpx; background:#efdfc8; }.audio-panel { margin:30rpx 0 18rpx; background:#f0e7d2; border-radius:28rpx; padding:26rpx; }.audio-panel .section-title { font-size:30rpx; margin:0; }.dialogue { height:680rpx; background:#fffdf8; border:2rpx solid #ecdac0; border-radius:28rpx; }.line { padding:26rpx; border-bottom:2rpx dashed #efdfc8; border-left:8rpx solid transparent; }.line.active { background:#f7e7cb; border-left-color:#a95639; }.line-speaker { color:#a57052; font-size:23rpx; display:flex; justify-content:space-between; }.english { font-size:35rpx; font-weight:650; margin:8rpx 0; }.translation { color:#8a7868; font-size:27rpx; }.difficulties { display:flex; gap:12rpx; }.difficulties button { flex:1; padding:18rpx 8rpx; border:2rpx solid transparent; }
