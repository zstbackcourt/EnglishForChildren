<view class="screen"><view class="eyebrow">A LITTLE CHALLENGE</view><view class="title">把星光装进口袋</view><view wx:if="{{loading}}" class="loading">五个小挑战正在准备…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry" disabled="{{busy}}">再试一次</button><button wx:if="{{!player}}" bindtap="players">去创建角色</button></view>
  <view wx:if="{{question &amp;&amp; !result &amp;&amp; !loading}}" class="card"><view class="row"><text class="pill">第 {{index + 1}} / 5 题</text><text class="muted">{{difficulties[attempt.difficulty]}}</text></view><view class="section-title question-title">{{question.prompt}}</view><view wx:if="{{question.display}}" class="question-display">{{question.display}}</view><button bindtap="hint" disabled="{{busy}}">🔊 听原版录音</button><view wx:if="{{audioError}}" class="error">{{audioError}}<button bindtap="retryAudio">重试音频</button></view>
    <view wx:if="{{question.type === 'choice'}}"><button wx:for="{{question.options}}" wx:key="index" class="option {{answer === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="choose" disabled="{{busy}}">{{item}}</button></view>
    <view wx:elif="{{question.type === 'order'}}"><view class="answer-tray">{{answer || '按顺序点单词，组成一句话'}}</view><view class="word-options"><button wx:for="{{optionItems}}" wx:key="id" class="small {{item.selected ? 'selected' : ''}}" data-index="{{item.id}}" bindtap="order" disabled="{{busy}}">{{item.text}}</button></view><view class="note">再点一次单词可以撤回。相同单词也可以分别选择。</view></view>
    <input wx:else class="field answer-input" value="{{answer}}" bindinput="typeAnswer" placeholder="写下你听到的单词" maxlength="100" disabled="{{busy}}"/>
    <button wx:if="{{index &lt; 4}}" class="primary" bindtap="next" disabled="{{!answer || busy}}">下一题 →</button><button wx:else class="primary" bindtap="submit" disabled="{{!answer || busy}}" loading="{{busy}}">{{busy ? '星光正在结算…' : '完成挑战 ✨'}}</button>
  </view>
  <view wx:if="{{result}}" class="result"><view class="result-icon">{{result.passed ? '🏆' : '🌱'}}</view><view class="title">{{result.passed ? '你收获了新成长！' : '每次尝试都在进步'}}</view><view class="result-score">{{result.score}} / {{result.total}}</view><view class="subtitle">本次收获 {{result.starsEarned}} 颗星光</view><view class="note">每课每难度首次过关获得星光，重复挑战可以刷新最好成绩。</view><view class="card feedback" wx:for="{{result.feedback}}" wx:key="index"><text class="pill">{{item.correct ? '✓ 答对了' : '再听听这一句'}}</text><view class="english">{{item.text}}</view><view wx:if="{{!item.correct}}" class="muted">正确答案：{{item.expected}}</view></view><view class="actions"><button class="primary" bindtap="rewards">看看星光收藏</button><button bindtap="again">再练一次</button></view><button bindtap="map">回到冒险地图</button></view>
</view>
