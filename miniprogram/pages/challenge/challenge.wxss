.question-title { margin-top:30rpx; }.question-display { font-size:36rpx; font-weight:650; padding:22rpx 0; }.option { text-align:left; font-weight:500; border:2rpx solid #e5d4bc; background:#fff8eb; }.answer-tray { min-height:116rpx; background:#f7ebd9; border:2rpx dashed #c8a681; border-radius:20rpx; padding:24rpx; font-size:33rpx; }.word-options { display:flex; flex-wrap:wrap; gap:12rpx; margin:24rpx 0; }.word-options button { margin:0; border:2rpx solid transparent; }.answer-input { margin:26rpx 0; }.result { text-align:center; padding-top:30rpx; }.result-icon { font-size:100rpx; }.result-score { font-size:80rpx; color:#a95639; font-weight:750; }.feedback { text-align:left; }.feedback .english { margin-top:18rpx; font-size:32rpx; }
