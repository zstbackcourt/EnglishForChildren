[Unit]
Description=English Adventure HTTPS proxy
After=network-online.target english-adventure.service
Wants=network-online.target
[Service]
Type=simple
DynamicUser=yes
StateDirectory=english-adventure-proxy
Environment=XDG_DATA_HOME=/var/lib/english-adventure-proxy
Environment=XDG_CONFIG_HOME=/var/lib/english-adventure-proxy
ExecStart=/opt/english-adventure/caddy run --config /etc/english-adventure/Caddyfile --adapter caddyfile
ExecReload=/opt/english-adventure/caddy reload --config /etc/english-adventure/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
[Install]
WantedBy=multi-user.target
